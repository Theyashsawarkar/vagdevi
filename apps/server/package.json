{
  "name": "@pustak/server",
  "version": "0.1.0",
  "private": true,
  "description": "The laptop side: serves your book folders to your phone.",
  "type": "module",
  "bin": { "pustak": "./bin/pustak.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/server": "11.19.0",
    "qrcode-terminal": "0.12.0",
    "smol-toml": "1.9.1",
    "wordnet-db": "3.1.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@trpc/client": "11.19.0",
    "@types/node": "26.6.5",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
